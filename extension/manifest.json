{
  "manifest_version": 3,
  "name": "Glass Tab",
  "version": "1.0.0",
  "description": "A liquid-glass new tab with a lock-screen clock, widgets and wallpapers, plus a glass search bar and glass Google results.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open glass search",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-glass-bar": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open the glass search bar"
    }
  },
  "permissions": ["storage", "topSites", "sessions", "search", "favicon", "activeTab", "scripting", "tabs", "alarms", "notifications"],
  "optional_host_permissions": ["https://www.google.com/*", "https://calendar.google.com/*", "https://*.icloud.com/*"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*"
  ],
  "web_accessible_resources": [
    { "resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"] }
  ]
}
