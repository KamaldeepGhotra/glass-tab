{
  "manifest_version": 3,
  "name": "Glass Tab",
  "version": "0.2.0",
  "description": "A calm, liquid-glass new tab page and search bar.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-glass-bar": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open the glass search bar"
    }
  },
  "permissions": ["storage", "topSites", "sessions", "search", "favicon", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "web_accessible_resources": [
    { "resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"] }
  ]
}
